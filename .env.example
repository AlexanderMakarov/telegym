# telegym — example environment.
#
# Telegym binaries read configuration straight from the process environment.
# This file documents every variable telegym knows about; all defaults work
# without you setting anything.
#
# To use this file as a real env source:
#   cp .env.example .env
#   set -a; source .env; set +a
#   ./bin/telegym-mock
#
# Or `make init` does the copy step for you.

# ──── telegym-mock ─────────────────────────────────────────────────────
# Bot API HTTP listen address
# TELEGYM_MOCK_LISTEN=:5678

# Prometheus /metrics listen address. Default :9104. Set to empty to disable.
# TELEGYM_MOCK_METRICS_LISTEN=:9104

# Fallback webhook URL when a bot has not called setWebhook. Polling bots must
# call deleteWebhook first (getUpdates returns 409 while a webhook is active).
# TELEGYM_MOCK_DEFAULT_WEBHOOK=

# Maximum bytes retained for uploaded files. Default 104857600 (100 MiB).
# TELEGYM_MOCK_FILE_STORE_MAX_BYTES=104857600

# Suppress per-request access logs
# TELEGYM_MOCK_QUIET=false

# Record Bot API calls (method, parameters, status) for GET /debug/requests/:token.
# Keeps the last 5000 calls per bot; set to false on load runs to skip the work.
# TELEGYM_MOCK_REQUEST_JOURNAL=true

# Realistic failure modes (all off by default):
# 429 + retry_after past Telegram flood limits: 30 msg/s per bot, ~1/s per
# private chat (bursts of 3), 20/min per group. Applies to send*, copy*, forward*.
# TELEGYM_MOCK_RATE_LIMITS=false
# Override any limit as rate[,burst] with N/s, N/min or N/h. The burst is how
# many messages may go out at once before the rate applies (default: N).
# TELEGYM_MOCK_RATE_LIMIT_BOT=30/s
# Calls with allow_paid_broadcast=true (0.1 Stars each) use this instead.
# TELEGYM_MOCK_RATE_LIMIT_PAID=1000/s
# TELEGYM_MOCK_RATE_LIMIT_PRIVATE=1/s,3
# TELEGYM_MOCK_RATE_LIMIT_GROUP=20/min
# Delay every Bot API call: fixed (50ms) or uniform random range (20ms-150ms).
# TELEGYM_MOCK_LATENCY=
# Fraction of Bot API calls answered with 500 Internal Server Error (0-1).
# TELEGYM_MOCK_FAULT_RATE=0

# ──── echobot (demo bot) ───────────────────────────────────────────────
# Bot token echobot uses to identify itself to the mock
# BOT_TOKEN=1234567890:telegym_default_mock_token_xxxxxxxx

# Mock URL echobot points at (must match TELEGYM_MOCK_LISTEN)
# TELEGYM_MOCK_URL=http://localhost:5678

# Address the mock dispatches updates to (echobot's webhook listener)
# ECHOBOT_LISTEN=:8443

# ──── telegym-proxy (real Telegram → mock relay) ───────────────────────
# Real bot token from @BotFather — REQUIRED when running telegym-proxy
# PROXY_TOKEN=

# Mock URL the proxy forwards real Telegram messages to
# MOCK_URL=http://localhost:5678

# Token of the bot-under-test on the mock side
# MOCK_BOT_TOKEN=1234567890:telegym_default_mock_token_xxxxxxxx

# Address the proxy listens on for mock /forward callbacks
# TELEGYM_PROXY_LISTEN=:8090

# Public URL of the proxy (set when running behind ngrok/cloudflared)
# TELEGYM_PROXY_PUBLIC_URL=

# Restrict the proxy to a single Telegram user_id (optional)
# ALLOWED_USER_ID=

# ──── xk6 scenarios ────────────────────────────────────────────────────
# Token scenarios use when injecting Updates into the mock
# TELEGYM_BOT_TOKEN=1234567890:telegym_default_mock_token_xxxxxxxx

# Outbound bot messages kept per chat (newest first). Each poll scans only its
# own chat. Memory peaks at about chats x 2 x this value x ~1-2 KB per message
# (keyboards included): 1000 chats at 200 is roughly 0.5 GB.
# TELEGYM_MOCK_MAX_MESSAGES_PER_CHAT=200
